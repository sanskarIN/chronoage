{
  "name": "chronoage",
  "private": true,
  "version": "2.0.13",
  "type": "module",
  "description": "A privacy-first, timezone-aware age and date calculator for web, desktop, Android, and iOS.",
  "author": "Sanskar <sanskarin@outlook.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanskarIN/chronoage.git"
  },
  "homepage": "https://github.com/sanskarIN/chronoage#readme",
  "bugs": {
    "url": "https://github.com/sanskarIN/chronoage/issues"
  },
  "funding": "https://buymeacoffee.com/sanskarIN",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "metadata:check": "node scripts/check-metadata.mjs",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "actions:check": "node scripts/check-actions.mjs",
    "security:check": "node scripts/check-security.mjs",
    "performance:check": "node scripts/check-bundle-size.mjs",
    "release:check": "node scripts/check-release-tag.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:locks:check": "node scripts/check-lockfiles.mjs --all",
    "release:npm-lock:check": "node scripts/check-lockfiles.mjs --npm",
    "release:cargo-lock:check": "node scripts/check-lockfiles.mjs --cargo",
    "release:workflow:check": "node scripts/check-release-workflow.mjs",
    "check": "npm run format:check && npm run metadata:check && npm run compatibility:check && npm run actions:check && npm run release:workflow:check && npm run security:check && npm run lint && npm run typecheck && npm run test && npm run docs:links && npm run build && npm run performance:check",
    "docs:links": "node scripts/check-links.mjs",
    "bench": "vitest bench tests/dateMath.bench.ts",
    "native": "tauri",
    "native:info": "tauri info",
    "native:icons": "tauri icon public/logo.svg --ios-color \"#6657E8\"",
    "native:dev": "npm run native:icons && tauri dev",
    "native:build": "npm run native:icons && tauri build",
    "native:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "native:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "native:check": "npm run native:icons && npm run native:format:check && cargo check --manifest-path src-tauri/Cargo.toml && npm run native:lint",
    "native:android:init": "npm run native:icons && tauri android init --ci && npm run native:icons",
    "native:android:dev": "tauri android dev",
    "native:android:build": "tauri android build",
    "native:android:apk": "tauri android build --apk",
    "native:android:aab": "tauri android build --aab",
    "native:ios:init": "npm run native:icons && tauri ios init --ci && npm run native:icons",
    "native:ios:dev": "tauri ios dev",
    "native:ios:build": "tauri ios build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "27.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
